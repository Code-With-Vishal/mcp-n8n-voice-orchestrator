{
  "name": "Vapi Missed Call Recovery (Idempotent)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vapi-missed-call-recovery",
        "responseMode": "onReceived"
      },
      "id": "webhook-entry",
      "name": "Webhook Ingress",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO webhook_locks (idempotency_key, channel) VALUES ($1, $2) ON CONFLICT (idempotency_key) DO NOTHING RETURNING idempotency_key;",
        "options": {
          "queryReplacement": "={{ $json.headers['x-idempotency-key'] }},{{ $json.headers['x-source-channel'] }}"
        }
      },
      "id": "postgres-idempotency-lock",
      "name": "Postgres State Lock",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [480, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.idempotency_key !== undefined }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-first-delivery",
      "name": "First Delivery?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [710, 300]
    },
    {
      "parameters": {},
      "id": "first-delivery-branch",
      "name": "Add WhatsApp / SMS nodes here",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 220]
    },
    {
      "parameters": {},
      "id": "duplicate-branch",
      "name": "Duplicate, skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 400]
    }
  ],
  "connections": {
    "Webhook Ingress": {
      "main": [[{ "node": "Postgres State Lock", "type": "main", "index": 0 }]]
    },
    "Postgres State Lock": {
      "main": [[{ "node": "First Delivery?", "type": "main", "index": 0 }]]
    },
    "First Delivery?": {
      "main": [
        [{ "node": "Add WhatsApp / SMS nodes here", "type": "main", "index": 0 }],
        [{ "node": "Duplicate, skip", "type": "main", "index": 0 }]
      ]
    }
  }
}
